# Django / entorno
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria-de-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
BACKEND_PUBLIC_URL=http://localhost:8000

# Base de datos (dejar DB_ENGINE vacío para SQLite local)
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_SSL_MODE=PREFERRED

# Email / SMTP: para Gmail completar según LEEME_GMAIL_2026-10-05.md
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
AUTH_CANAL_VERIFICACION=email
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Firebase
FCM_CREDENTIALS_PATH=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
